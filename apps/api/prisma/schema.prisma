// IDs are UUIDv7 generated by the application (newId() from @erp/shared); no DB default.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  trial
  active
  suspended
  cancelled

  @@map("tenant_status")
}

enum DeviceType {
  pos
  waiter
  kds
  print_agent

  @@map("device_type")
}

model Plan {
  id                String   @id @db.Uuid
  name              String
  code              String   @unique
  maxBranches       Int      @map("max_branches")
  maxDevices        Int      @map("max_devices")
  features          Json     @default("{}")
  monthlyPricePaisa BigInt   @map("monthly_price_paisa")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  tenants           Tenant[]

  @@map("plans")
}

model Tenant {
  id           String       @id @db.Uuid
  name         String
  slug         String       @unique
  customDomain String?      @unique @map("custom_domain")
  planId       String       @map("plan_id") @db.Uuid
  status       TenantStatus @default(trial)
  trialEndsAt  DateTime?    @map("trial_ends_at")
  timezone     String       @default("Asia/Karachi")
  currency     String       @default("PKR")
  ownerUserId  String?      @unique @map("owner_user_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  plan      Plan       @relation(fields: [planId], references: [id])
  owner     User?      @relation("TenantOwner", fields: [ownerUserId], references: [id])
  branches  Branch[]
  users     User[]     @relation("TenantUsers")
  roles     Role[]
  devices   Device[]
  auditLogs AuditLog[]

  @@map("tenants")
}

model Branch {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  code          String
  address       String?
  phone         String?
  lat           Decimal? @db.Decimal(9, 6)
  lng           Decimal? @db.Decimal(9, 6)
  ntn           String?
  strn          String?
  dayCutoffTime String   @default("04:00") @map("day_cutoff_time")
  settings      Json     @default("{}")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  devices      Device[]
  userBranches UserBranch[]
  auditLogs    AuditLog[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Device {
  id         String     @id @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  branchId   String     @map("branch_id") @db.Uuid
  name       String
  code       String
  type       DeviceType
  tokenHash  String?    @map("token_hash")
  lastSeenAt DateTime?  @map("last_seen_at")
  appVersion String?    @map("app_version")
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  branch    Branch     @relation(fields: [branchId], references: [id])
  auditLogs AuditLog[]

  @@unique([branchId, code])
  @@index([tenantId])
  @@map("devices")
}

model Role {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  name               String
  isSystem           Boolean  @default(false) @map("is_system")
  maxDiscountPercent Int      @default(0) @map("max_discount_percent")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model User {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  email        String?
  phone        String?
  passwordHash String?   @map("password_hash")
  pinHash      String?   @map("pin_hash")
  roleId       String    @map("role_id") @db.Uuid
  employeeId   String?   @map("employee_id") @db.Uuid
  allBranches  Boolean   @default(false) @map("all_branches")
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant         Tenant       @relation("TenantUsers", fields: [tenantId], references: [id])
  ownedTenant    Tenant?      @relation("TenantOwner")
  role           Role         @relation(fields: [roleId], references: [id])
  branches       UserBranch[]
  auditLogs      AuditLog[]   @relation("AuditActor")
  approvedAudits AuditLog[]   @relation("AuditApprover")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model UserBranch {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model AuditLog {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  approverUserId String?  @map("approver_user_id") @db.Uuid
  deviceId       String?  @map("device_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  reason         String?
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  branch   Branch? @relation(fields: [branchId], references: [id])
  user     User?   @relation("AuditActor", fields: [userId], references: [id])
  approver User?   @relation("AuditApprover", fields: [approverUserId], references: [id])
  device   Device? @relation(fields: [deviceId], references: [id])

  @@index([tenantId, action, createdAt])
  @@map("audit_logs")
}
